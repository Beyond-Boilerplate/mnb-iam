# Meridian OpenLDAP bootstrap — enterprise-shaped DIT for IIQ OpenLDAP - Direct
#
# Loaded once on first container create (baked into mnb-openldap image).
# Recreate + wipe volumes to reload after editing this file and rebuilding:
#   docker compose -f docker-compose.iiq.yml build openldap
#   docker compose -f docker-compose.iiq.yml up -d --force-recreate openldap
#
# Suffix / admin (from compose env): dc=meridiannb,dc=com
#   Bind admin:  cn=admin,dc=meridiannb,dc=com / admin
#   Bind read:   cn=svc-iiq-read,dc=meridiannb,dc=com / Readonly1!   (aggregate-only)
#   Bind write:  cn=svc-iiq-provision,ou=service,dc=meridiannb,dc=com / Provision1!
#                (IIQ app bind when PROVISIONING enabled — single connector bind does both)
#
# IIQ from Docker network: host=openldap port=389
# IIQ / ldapsearch from host: host=localhost port=389
#
# Correlation: employeeNumber ↔ HR userId (MNB000xx). Native identity: uid.

dn: ou=people,dc=meridiannb,dc=com
objectClass: organizationalUnit
ou: people
description: End-user accounts (inetOrgPerson)

dn: ou=groups,dc=meridiannb,dc=com
objectClass: organizationalUnit
ou: groups
description: Application and network entitlement groups (groupOfUniqueNames)

dn: ou=service,dc=meridiannb,dc=com
objectClass: organizationalUnit
ou: service
description: Connector service binds (provision account lives here; read-only bind is at the suffix)

dn: cn=svc-iiq-provision,ou=service,dc=meridiannb,dc=com
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: svc-iiq-provision
userPassword: Provision1!
description: IdentityIQ provision+aggregate bind — write on ou=people and ou=groups (lab)


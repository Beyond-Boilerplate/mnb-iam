# Copy to tools/iiq-chat/.env (never commit real secrets)

# --- MCP (required for Teller + Auto-story) ---
IIQ_MCP_URL=http://127.0.0.1:8766/mcp
MCP_API_KEY=mnb-lab-mcp-key

# --- Teller HTTP ---
CHAT_HOST=127.0.0.1
CHAT_PORT=4180

# --- LLM (Teller chat + Auto-story implement agent) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,inclusionai/ling-3.0-flash:free,cohere/north-mini-code:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_REFERER=http://localhost:4180

# Optional alternate OpenAI-compatible providers (Auto-story config.yaml llm.provider)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# GEMINI_API_KEY=

# --- IIQ (org chart / console SCIM fallbacks; Docker compose also sets these) ---
IIQ_BASE_URL=http://127.0.0.1:8080/identityiq
IIQ_USER=spadmin
IIQ_PASSWORD=admin

# --- Auto-story UI + runner (mounted into mnb-iiq-chat) ---
SAILPOINT_ROOT=
# AI_DELIVERY_DIR=.ai-delivery
# AUTO_STORY_CONFIG=scripts/auto_story/config.yaml

# --- Jira (live poll / claim / In Review — CLI; never auto-Done) ---
JIRA_SITE=
JIRA_EMAIL=
JIRA_BOT_EMAIL=
JIRA_API_TOKEN=

  {
    "id": "ops-rebuild-managers",
    "tier": "full",
    "tags": ["ops", "manager", "write"],
    "mutate": true,
    "query": "Rebuild the manager hierarchy from MNB-HR link attributes.",
    "expect": {
      "http_ok": true,
      "tools_any_of": ["rebuild_manager_hierarchy"],
      "reply_contains_any": ["manager", "rebuild", "set", "linked", "MNB-HR"],

[
  {
    "id": "cert-create-from-template",
    "tier": "core",
    "tags": ["cert", "governance", "write", "regression"],
    "mutate": true,
    "query": "Create a certification campaign called MNB-Lab-Manager-Cert from a template",
    "xfail": true,
    "xfail_reason": "Agent asked for template name instead of listing templates / using create_certification_campaign with a default OOTB template.",
    "pass_if_any": [
      {
        "tools_any_of": ["create_certification_campaign", "launch_certification_campaign", "create_cert_from_template"],
        "reply_contains_any": ["MNB-Lab-Manager-Cert", "campaign", "created", "Certification"],
        "reply_not_contains_any": [
          "provide the template name",
          "which template",
          "Could you please provide the template"
        ],
        "no_tool_errors": true
      },
      {
        "min_tools": 2,
        "tools_any_of": ["create_certification_campaign", "list_certifications", "list_report_definitions"],
        "reply_contains_any": ["MNB-Lab-Manager-Cert", "campaign", "template"],
        "reply_not_contains_any": ["provide the template name", "Could you please provide"]
      }
    ]
  },

# Copy to scripts/auto_story/.env or export in the shell before:
#   python3 -m scripts.auto_story poll|run
# (Auto-story also reads the same keys from the process environment /
#  tools/iiq-chat/.env when run via the Teller UI dry-run job.)

# --- MCP ---
IIQ_MCP_URL=http://127.0.0.1:8766/mcp
MCP_API_KEY=mnb-lab-mcp-key

# --- LLM (implement agent; --no-llm skips) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# OPENAI_API_KEY=
# llm.api_key_env in config.yaml selects which key is used

# --- Jira board contract (agent-ready → In Progress → In Review only) ---
JIRA_SITE=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
# JIRA_BOT_EMAIL=bot@example.com
JIRA_API_TOKEN=

# --- Paths (optional) ---
# AUTO_STORY_CONFIG=/absolute/path/to/config.yaml
# SAILPOINT_ROOT=/absolute/path/to/Sailpoint
# AI_DELIVERY_DIR=/absolute/path/to/.ai-delivery

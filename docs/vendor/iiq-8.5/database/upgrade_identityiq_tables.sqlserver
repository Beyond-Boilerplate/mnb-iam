--
-- This script contains DDL statements to upgrade a database schema to
-- reflect changes to the model.  This file should only be used to
-- upgrade from the last formal release version to the current code base.
--
-- The CONTEXT-SWITCH token is used to notify the upgrader of a change in database context. The token is from
-- the iiq.properties file which represents the database url.
--

USE identityiq
GO

-- DO NOT REMOVE OR MODIFY BLOCK
-- CONTEXT-SWITCH: dataSource
-- DO NOT REMOVE OR MODIFY BLOCK
--

EXEC sp_rename N'identityiq.spt_named_timestamp.uk_c5tewl8ylk44ns0wx9lik19ae', N'UK_c5tewl8ylk44ns0wx9lik19ae', N'INDEX';
GO

ALTER TABLE identityiq.spt_managed_attr_target_perms ALTER COLUMN target nvarchar(max);
GO

create index spt_workflowcase_name on identityiq.spt_workflow_case (name);
GO


create table identityiq.spt_adaptive_card_notification_template (
        id nvarchar(32) not null,
        created numeric(19,0),
        modified numeric(19,0),
        significant_modified numeric(19,0),
        assigned_scope_path nvarchar(450),
        name nvarchar(128) not null,
        description nvarchar(1024),
        body nvarchar(max),
        owner nvarchar(32),
        assigned_scope nvarchar(32),
        primary key (id)
    );
GO

alter table identityiq.spt_adaptive_card_notification_template
       add constraint UK_dp45be316f5l6ayk12n8bt7vv unique (name);
GO

alter table identityiq.spt_adaptive_card_notification_template
       add constraint FK80bgxu2v1yd9x4e2ha8b3jdvp
       foreign key (owner)
       references identityiq.spt_identity;
GO

create index FK80bgxu2v1yd9x4e2ha8b3jdvp on identityiq.spt_adaptive_card_notification_template (owner);
GO

alter table identityiq.spt_adaptive_card_notification_template
       add constraint FK90nti8lwr50moob5fvushxld8
       foreign key (assigned_scope)
       references identityiq.spt_scope;
GO

create index FK90nti8lwr50moob5fvushxld8 on identityiq.spt_adaptive_card_notification_template (assigned_scope);
GO

create index SPT_IDXD711E2C348ADC6C on identityiq.spt_adaptive_card_notification_template (assigned_scope_path);
GO

create table identityiq.spt_async_request (
       id nvarchar(32) not null,
        created numeric(19,0),
        modified numeric(19,0),
        significant_modified numeric(19,0),
        type nvarchar(55),
        result nvarchar(4000),
        poll_interval int,
        reference nvarchar(128),
        status nvarchar(128),
        reference_type nvarchar(128),
        batch_id nvarchar(128),
        primary key (id)
    );
    GO
create index spt_async_request_reference_type_combined on identityiq.spt_async_request (type, reference);
GO
create index spt_async_request_reference_type on identityiq.spt_async_request (reference_type);
GO
create index spt_async_request_batch_id on identityiq.spt_async_request (batch_id);
GO
create index spt_cert_archive_name on identityiq.spt_certification_archive (name);
GO



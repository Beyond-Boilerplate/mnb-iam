--
-- This script contains DDL statements to upgrade a database schema to
-- reflect changes to the model.  This file should only be used to
-- upgrade from the last formal release version to the current code base.
--
-- The CONTEXT-SWITCH token is used to notify the upgrader of a change in database context. The token is from
-- the iiq.properties file which represents the database url.
--

-- DO NOT REMOVE OR MODIFY BLOCK
-- CONTEXT-SWITCH: dataSource
-- DO NOT REMOVE OR MODIFY BLOCK

alter table identityiq.spt_named_timestamp drop constraint uk_c5tewl8ylk44ns0wx9lik19ae;
alter table identityiq.spt_named_timestamp add constraint UK_c5tewl8ylk44ns0wx9lik19ae unique (name);

--
-- This particular fix is part of IIQTC-562
-- The statement added was ALTER TABLE identityiq.spt_managed_attr_target_perms MODIFY target clob
-- Since the target column type cannot be modified to clob directly
-- the below statements are used to achieve it.
--
alter table identityiq.spt_managed_attr_target_perms add clob_column clob;
update identityiq.spt_managed_attr_target_perms set clob_column = to_clob(target);
alter table identityiq.spt_managed_attr_target_perms drop column target;
alter table identityiq.spt_managed_attr_target_perms rename column clob_column to target;

create index identityiq.spt_workflowcase_name on identityiq.spt_workflow_case (name);



create table identityiq.spt_adaptive_card_notification_template (
        id varchar2(32 char) not null,
        created number(19,0),
        modified number(19,0),
        significant_modified number(19,0),
        assigned_scope_path varchar2(450 char),
        name varchar2(128 char) not null,
        description varchar2(1024 char),
        body clob,
        owner varchar2(32 char),
        assigned_scope varchar2(32 char),
        primary key (id)
    );

alter table identityiq.spt_adaptive_card_notification_template
       add constraint UK_dp45be316f5l6ayk12n8bt7vv unique (name);

alter table identityiq.spt_adaptive_card_notification_template
       add constraint FK80bgxu2v1yd9x4e2ha8b3jdvp
       foreign key (owner)
       references identityiq.spt_identity;

create index identityiq.FK80bgxu2v1yd9x4e2ha8b3jdvp on identityiq.spt_adaptive_card_notification_template (owner);

alter table identityiq.spt_adaptive_card_notification_template
       add constraint FK90nti8lwr50moob5fvushxld8
       foreign key (assigned_scope)
       references identityiq.spt_scope;

create index identityiq.FK90nti8lwr50moob5fvushxld8 on identityiq.spt_adaptive_card_notification_template (assigned_scope);

create index identityiq.SPT_IDXD711E2C348ADC6C on identityiq.spt_adaptive_card_notification_template (assigned_scope_path);

create index identityiq.spt_adaptive_card_notification on identityiq.spt_adaptive_card_notification_template (upper(name));


create table identityiq.spt_async_request (
       id varchar2(32 char) not null,
        created number(19,0),
        modified number(19,0),
        significant_modified number(19,0),
        type varchar2(55 char),
        result varchar2(4000 char),
        poll_interval number(10,0),
        reference varchar2(128 char),
        status varchar2(128 char),
        reference_type varchar2(128 char),
        batch_id varchar2(128 char),
        primary key (id)
    );

create index identityiq.spt_async_request_reference_type_combined on identityiq.spt_async_request (type, reference);


create index identityiq.spt_async_request_reference_type on identityiq.spt_async_request (reference_type);

create index identityiq.spt_async_request_batch_id on identityiq.spt_async_request (batch_id);

create index identityiq.spt_cert_archive_name on identityiq.spt_certification_archive (name);


# syntax=docker/dockerfile:1.6
# Meridian IIQ Teller chatbot (pre-baked MCP + OpenRouter).
FROM python:3.12-slim-bookworm

WORKDIR /app
COPY tools/iiq-chat /app/tools/iiq-chat

ENV PYTHONUNBUFFERED=1 \
    CHAT_HOST=0.0.0.0 \
    CHAT_PORT=4180 \
    IIQ_MCP_URL=http://iiq-mcp:8766/mcp \
    MCP_API_KEY=mnb-lab-mcp-key

EXPOSE 4180
HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=15s \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4180/api/config')" || exit 1

WORKDIR /app/tools/iiq-chat
CMD ["python3", "serve.py"]

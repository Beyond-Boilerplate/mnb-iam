# Meridian connector mock (Lessons 68–69)
FROM python:3.12-alpine
WORKDIR /app
COPY tools/connector-mock/serve.py /app/serve.py
COPY lab-data/connectors/webservices/sample-users.json /app/lab-data/connectors/webservices/sample-users.json
COPY lab-data/connectors/scim/Users.json /app/lab-data/connectors/scim/Users.json
# serve.py resolves ROOT as parents[2] from tools/connector-mock — fake layout:
RUN mkdir -p /opt/mnb/tools/connector-mock /opt/mnb/lab-data/connectors/webservices /opt/mnb/lab-data/connectors/scim \
 && cp /app/serve.py /opt/mnb/tools/connector-mock/serve.py \
 && cp /app/lab-data/connectors/webservices/sample-users.json /opt/mnb/lab-data/connectors/webservices/ \
 && cp /app/lab-data/connectors/scim/Users.json /opt/mnb/lab-data/connectors/scim/
WORKDIR /opt/mnb
ENV MOCK_HOST=0.0.0.0 MOCK_PORT=8091
EXPOSE 8091
CMD ["python3", "tools/connector-mock/serve.py"]

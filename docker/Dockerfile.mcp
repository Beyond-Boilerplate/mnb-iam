# syntax=docker/dockerfile:1.6
# IdentityIQ MCP server (FastMCP HTTP) for the Meridian lab stack.
FROM python:3.12-slim-bookworm

WORKDIR /app
COPY tools/iiq-mcp/pyproject.toml tools/iiq-mcp/README.md ./
COPY tools/iiq-mcp/src ./src
RUN pip install --no-cache-dir . \
  && mkdir -p /var/mcp

ENV PYTHONUNBUFFERED=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8766 \
    MCP_PATH=/mcp \
    IIQ_BASE_URL=http://identityiq:8080/identityiq \
    IIQ_USER=spadmin \
    IIQ_PASSWORD=admin \
    IIQ_MCP_ENABLED_PHASES=1,2,3,4 \
    IIQ_MCP_AUDIT_LOG=/var/mcp/mcp-write-audit.jsonl \
    IIQ_MCP_IDEMPOTENCY_DB=/var/mcp/mcp-idempotency.sqlite

EXPOSE 8766
HEALTHCHECK --interval=15s --timeout=5s --retries=10 --start-period=20s \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8766/healthz')" || exit 1

CMD ["python", "-m", "iiq_mcp"]

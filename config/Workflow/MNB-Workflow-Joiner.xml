<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Workflow PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!-- Meridian joiner skeleton — extend in Lessons 29–34; not a full LCM production workflow. -->
<Workflow explicitTransitions="true" name="MNB-Workflow-Joiner" type="IdentityLifecycle">
  <Variable input="true" name="identityName">
    <Description>Joiner identity name</Description>
  </Variable>
  <Variable initializer="string:Joiner" name="flow"/>
  <Variable initializer="LCM" name="source"/>
  <Description>
    Academy joiner lifecycle stub for Meridian. Wire approvals, birthright, and provisioning
    in Lessons 29–36. Safe no-op start step for import/smoke.
  </Description>
  <Step icon="Start" name="Start" posX="20" posY="20">
    <Transition to="Notify"/>
  </Step>
  <Step icon="Message" name="Notify" posX="160" posY="20">
    <Arg name="template" value="MNB-EmailTemplate-Joiner-Notify"/>
    <Description>Placeholder notify step — configure email in Lesson 49.</Description>
    <Transition to="Stop"/>
  </Step>
  <Step icon="Stop" name="Stop" posX="300" posY="20"/>
</Workflow>

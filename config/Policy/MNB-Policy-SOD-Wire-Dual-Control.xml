<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Policy PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!-- Meridian wire dual-control SoD — Lessons 39–41. Inactive until entitlements exist. -->
<Policy certificationActions="Remediated,Mitigated,Delegated"
        configPage="entitlementPolicy.xhtml"
        executor="sailpoint.policy.EntitlementSODPolicyExecutor"
        name="MNB-SOD-Wire-Dual-Control"
        state="Inactive"
        type="EntitlementSOD"
        typeKey="policy_type_entitlement_sod"
        violationOwnerType="Identity">
  <PolicyAlert disabled="true" escalationStyle="none"/>
  <Attributes>
    <Map>
      <entry key="sysDescriptions">
        <value>
          <Map>
            <entry key="en_US" value="Wire initiate vs approve must not coexist on one identity (dual control). Activate after MNB-IT-Access / Wire entitlements are catalogued."/>
          </Map>
        </value>
      </entry>
    </Map>
  </Attributes>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </Owner>
  <ViolationOwner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </ViolationOwner>
  <GenericConstraints>
    <GenericConstraint name="Wire Init vs Approve" violationOwnerType="None">
      <IdentitySelector>
        <MatchExpression>
          <MatchTerm name="itAccess" type="Entitlement" value="WIRE_INIT">
            <ApplicationRef>
              <Reference class="sailpoint.object.Application" name="MNB-IT-Access"/>
            </ApplicationRef>
          </MatchTerm>
        </MatchExpression>
      </IdentitySelector>
      <IdentitySelector>
        <MatchExpression>
          <MatchTerm name="itAccess" type="Entitlement" value="WIRE_APPR">
            <ApplicationRef>
              <Reference class="sailpoint.object.Application" name="MNB-IT-Access"/>
            </ApplicationRef>
          </MatchTerm>
        </MatchExpression>
      </IdentitySelector>
    </GenericConstraint>
  </GenericConstraints>
</Policy>

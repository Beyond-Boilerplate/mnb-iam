<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Bundle PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!-- Meridian IT role skeleton — directory / ELDAP packaging. Lessons 25–26. -->
<Bundle displayName="MNB IT Directory User" name="MNB-Role-IT-Directory-User" type="it">
  <Attributes>
    <Map>
      <entry key="sysDescriptions">
        <value>
          <Map>
            <entry key="en_US" value="Academy IT role for enterprise directory access (ELDAP). Wire profiles to MNB-IT-Access entitlements in Lessons 25–26."/>
          </Map>
        </value>
      </entry>
    </Map>
  </Attributes>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </Owner>
  <Profiles>
    <Profile>
      <ApplicationRef>
        <Reference class="sailpoint.object.Application" name="MNB-IT-Access"/>
      </ApplicationRef>
      <Constraints>
        <Filter operation="CONTAINS_ALL" property="itAccess">
          <Value>
            <List>
              <String>ELDAP</String>
            </List>
          </Value>
        </Filter>
      </Constraints>
    </Profile>
  </Profiles>
</Bundle>

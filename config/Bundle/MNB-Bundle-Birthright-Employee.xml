<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Bundle PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<Bundle displayName="MNB Birthright Employee" name="MNB-Bundle-Birthright-Employee" type="business">
  <Attributes>
    <Map>
      <entry key="sysDescriptions">
        <value>
          <Map>
            <entry key="en_US" value="Enterprise Lab birthright: Employee Portal + directory login eligibility."/>
          </Map>
        </value>
      </entry>
    </Map>
  </Attributes>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </Owner>
  <Selector>
    <IdentitySelector>
      <MatchExpression and="true">
        <MatchTerm name="employeeType" type="IdentityAttribute" value="Employee"/>
        <MatchTerm name="inactive" type="IdentityAttribute" value="false"/>
      </MatchExpression>
    </IdentitySelector>
  </Selector>
</Bundle>

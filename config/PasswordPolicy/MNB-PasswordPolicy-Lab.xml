<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE PasswordPolicy PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!-- Enterprise Lab v3 — IIQ policy strength aligned with lab OpenLDAP/Keycloak (Lesson 61 / 254). -->
<PasswordPolicy name="MNB-PasswordPolicy-Lab">
  <Description>Meridian lab password policy. IIQ strength must stay ≥ OpenLDAP/Keycloak target rules. Never log cleartext passwords.</Description>
  <PasswordConstraints>
    <Map>
      <entry key="checkPasswordMinCharacterType" value="true"/>
      <entry key="minNumeric" value="1"/>
      <entry key="minSpecial" value="1"/>
      <entry key="minUpper" value="1"/>
      <entry key="minLower" value="1"/>
      <entry key="passwordMinLength" value="10"/>
      <entry key="passwordHistory" value="5"/>
    </Map>
  </PasswordConstraints>
</PasswordPolicy>

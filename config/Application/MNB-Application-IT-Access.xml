<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE Application PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<!-- Meridian inventory — non-authoritative IT entitlement dump. Lessons 09–10. -->
<Application authoritative="false"
             connector="sailpoint.connector.DelimitedFileConnector"
             featuresString="DIRECT_PERMISSIONS, NO_RANDOM_ACCESS, DISCOVER_SCHEMA"
             icon="enterpriseIcon"
             name="MNB-IT-Access"
             type="DelimitedFile">
  <Attributes>
    <Map>
      <entry key="delimiter" value=","/>
      <entry key="file" value="%%MNB_IT_ACCESS_FILE%%"/>
      <entry key="filetransport" value="local"/>
      <entry key="filterEmptyRecords">
        <value>
          <Boolean>true</Boolean>
        </value>
      </entry>
      <entry key="hasHeader">
        <value>
          <Boolean>true</Boolean>
        </value>
      </entry>
      <entry key="mergeRows">
        <value>
          <Boolean>true</Boolean>
        </value>
      </entry>
      <entry key="parseType" value="delimited"/>
      <entry key="partitionMode" value="auto"/>
      <entry key="templateApplication" value="DelimitedFile Template"/>
      <entry key="sysDescriptions">
        <value>
          <Map>
            <entry key="en_US" value="Meridian IT access inventory. Create-identities OFF — never mint orphan identities."/>
          </Map>
        </value>
      </entry>
    </Map>
  </Attributes>
  <Owner>
    <Reference class="sailpoint.object.Identity" name="spadmin"/>
  </Owner>
  <Schemas>
    <Schema displayAttribute="userName"
            identityAttribute="employeeId"
            nativeObjectType="account"
            objectType="account"
            permissionsRemediationModificationType="None">
      <AttributeDefinition name="userName" type="string"/>
      <AttributeDefinition name="firstName" type="string"/>
      <AttributeDefinition name="lastName" type="string"/>
      <AttributeDefinition name="email" type="string"/>
      <AttributeDefinition name="jobTitle" type="string"/>
      <AttributeDefinition name="employeeId" type="string"/>
      <AttributeDefinition managed="true" multi="true" name="itAccess" type="string">
        <Description>IT entitlement / group codes (WIRE_INIT, SAP_FI, …)</Description>
      </AttributeDefinition>
      <AttributeDefinition name="accountStatus" type="string"/>
    </Schema>
  </Schemas>
</Application>
